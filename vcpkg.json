{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "vcpkg-share",
  "version": "0.1.0",
  "dependencies": [
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "wolfssl",
        "http3",
        "websockets",
        "zstd"
      ]
    },
    "zlib",
    "nlohmann-json",
    {
      "name": "wolfssl",
      "features": [
        "curve25519",
        "ed25519",
        "quic"
      ]
    }
  ],
  "features": {
    "tests": {
      "description": "c-share's unit tests (its C_SHARE_BUILD_TESTS): not in the prebuilt prefixes",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
